      <data key="d9">[{"evidence_key": "PMID:41439842:s09", "pair_id": "PMID:41439842:s09:p08", "doc_id": "PMID:41439842", "sent_id": "PMID:41439842:s09", "pmid": "41439842", "url": "https://europepmc.org/article/MED/41439842", "sentence_text": "The association was more pronounced among men and individuals with a history of heavy tobacco use.&lt;h4&gt;Conclusion&lt;/h4&gt;The estimated PAF for T2DM due to tobacco use underscores the significant contribution of policies established within the WHO Framework Convention on Tobacco Control to the prevention of chronic diseases.", "char_spans": [139, 158], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.8572211861610413, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.8572211861610413, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.857"}]}, {"evidence_key": "PMID:42189766:s07", "pair_id": "PMID:42189766:s07:p02", "doc_id": "PMID:42189766", "sent_id": "PMID:42189766:s07", "pmid": "42189766", "url": "https://europepmc.org/article/MED/42189766", "sentence_text": "While smoking exposure declined in all regions, low physical activity and diets high in red and processed meat increased over time.&lt;h4&gt;Conclusion&lt;/h4&gt;T2DM burden in Brazil is growing due to the increasing exposure to T2DM risk factors.", "char_spans": [6, 154], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.8625472187995911, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.8625472187995911, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.863"}]}]</data>
