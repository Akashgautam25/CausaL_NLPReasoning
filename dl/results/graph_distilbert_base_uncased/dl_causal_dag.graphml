      <data key="d9">[{"evidence_key": "PMID:42488722:s03", "pair_id": "PMID:42488722:s03:p04", "doc_id": "PMID:42488722", "sent_id": "PMID:42488722:s03", "pmid": "42488722", "url": "https://europepmc.org/article/MED/42488722", "sentence_text": "Metabolic syndrome (MetS)-defined by central obesity, hypertriglyceridemia, low HDL cholesterol, hypertension, and type 2 diabetes mellitus (T2DM)-is increasingly prevalent worldwide and is characterized by chronic immune dysregulation and alterations in gut microbiota.", "char_spans": [97, 139], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.8740982413291931, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.8740982413291931, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.874"}]}, {"evidence_key": "PMID:42575672:s08", "pair_id": "PMID:42575672:s08:p03", "doc_id": "PMID:42575672", "sent_id": "PMID:42575672:s08", "pmid": "42575672", "url": "https://europepmc.org/article/MED/42575672", "sentence_text": "Greater DASH adherence was associated with reduced risk of hypertension (aHR 0.91, 95% CI 0.86 to 0.96, p&lt;0.001) and T2DM (aHR 0.82, 95% CI 0.75 to 0.90, p&lt;0.001).&lt;h4&gt;Conclusions&lt;/h4&gt;Greater adherence to the DASH diet was associated with lower combined risk of HF and death due to HF, as well as hypertension and T2DM, supporting the role of a DASH diet in HF prevention.", "char_spans": [59, 317], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.7623047232627869, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.7623047232627869, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.762"}]}, {"evidence_key": "PMID:42523603:s09", "pair_id": "PMID:42523603:s09:p01", "doc_id": "PMID:42523603", "sent_id": "PMID:42523603:s09", "pmid": "42523603", "url": "https://europepmc.org/article/MED/42523603", "sentence_text": "T2DM, hypertension, and low HDL levels were independent risk factors for the presence of intrahepatic multifocal lesions at diagnosis.", "char_spans": [0, 18], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.897318959236145, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.897318959236145, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.897"}]}]</data>
