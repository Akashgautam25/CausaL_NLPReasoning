      <data key="d9">[{"evidence_key": "PMID:42824721:s12", "pair_id": "PMID:42824721:s12:p06", "doc_id": "PMID:42824721", "sent_id": "PMID:42824721:s12", "pmid": "42824721", "url": "https://europepmc.org/article/MED/42824721", "sentence_text": "Being female (AOR\u202f=\u202f2.36, 95% CI: 1.34-4.15), monthly income &gt;20,000 Ethiopian birr (AOR\u202f=\u202f2.38, 95% CI: 1.26-4.49), physical inactivity (AOR\u202f=\u202f2.36, 95% CI: 1.22-4.55) and poor glycemic control (AOR\u202f=\u202f8.86, 95% CI: 4.67-16.80) were also significantly associated with higher odds of overweight or obesity.&lt;h4&gt;Conclusion&lt;/h4&gt;In this single-center cross-sectional study, more than half of participants met body mass index criteria for overweight or obesity.", "char_spans": [117, 293], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.8699, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.8899928331375122, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.890"}, {"extractor": "FineTuned-DistilBERT", "confidence": 0.8497464656829834, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.850"}]}]</data>
