      <data key="d9">[{"evidence_key": "PMID:42488722:s03", "pair_id": "PMID:42488722:s03:p01", "doc_id": "PMID:42488722", "sent_id": "PMID:42488722:s03", "pmid": "42488722", "url": "https://europepmc.org/article/MED/42488722", "sentence_text": "Metabolic syndrome (MetS)-defined by central obesity, hypertriglyceridemia, low HDL cholesterol, hypertension, and type 2 diabetes mellitus (T2DM)-is increasingly prevalent worldwide and is characterized by chronic immune dysregulation and alterations in gut microbiota.", "char_spans": [45, 109], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.8964994549751282, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.8964994549751282, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.896"}]}, {"evidence_key": "PMID:42422434:s11", "pair_id": "PMID:42422434:s11:p01", "doc_id": "PMID:42422434", "sent_id": "PMID:42422434:s11", "pmid": "42422434", "url": "https://europepmc.org/article/MED/42422434", "sentence_text": "Risk factors for HUA included impaired renal function, obesity, dyslipidemia, hypertension, metabolic syndrome, and alcohol consumption, while elevated HbA1c was inversely associated with HUA.", "char_spans": [55, 90], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.8953664898872375, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.8953664898872375, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.895"}]}, {"evidence_key": "PMID:42422434:s13", "pair_id": "PMID:42422434:s13:p01", "doc_id": "PMID:42422434", "sent_id": "PMID:42422434:s13", "pmid": "42422434", "url": "https://europepmc.org/article/MED/42422434", "sentence_text": "Impaired renal function, obesity, dyslipidemia, hypertension, MetS, and alcohol consumption are the primary risk factors.", "char_spans": [25, 60], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.9081966280937195, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.9081966280937195, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.908"}]}, {"evidence_key": "PMID:42653674:s01", "pair_id": "PMID:42653674:s01:p01", "doc_id": "PMID:42653674", "sent_id": "PMID:42653674:s01", "pmid": "42653674", "url": "https://europepmc.org/article/MED/42653674", "sentence_text": "&lt;b&gt;Background/Objectives&lt;/b&gt;: The global rise in obesity-related hypertension, metabolic syndrome, and chronic inflammation calls for a precise characterization of the safety profiles of first-line therapies.", "char_spans": [49, 77], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.9577569365501404, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.9577569365501404, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.958"}]}, {"evidence_key": "PMID:42615248:s06", "pair_id": "PMID:42615248:s06:p10", "doc_id": "PMID:42615248", "sent_id": "PMID:42615248:s06", "pmid": "42615248", "url": "https://europepmc.org/article/MED/42615248", "sentence_text": "Overall, 72.4% of participants had at least 1 comorbidity, most often overweight/obesity (63.4%) (composite measure: overweight/obesity, hypertension, and reduced eGFR), and 81.1% had at least 1 diabetes-related complication, most commonly neuropathy (59.6%).", "char_spans": [128, 149], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.8464789986610413, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.8464789986610413, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.846"}]}, {"evidence_key": "PMID:42656766:s13", "pair_id": "PMID:42656766:s13:p29", "doc_id": "PMID:42656766", "sent_id": "PMID:42656766:s13", "pmid": "42656766", "url": "https://europepmc.org/article/MED/42656766", "sentence_text": "These factors were grouped into three categories: socio-demographic factors (age, sex, place of residence, educational level, monthly income and family history of overweight/obesity); behavioral factors (physical activity/exercise, dietary practice, alcohol consumption, walking status, walking level and vigorous physical activity); and clinical factors (comorbid hypertension, duration of diabetes, central obesity and triglyceride level).&lt;h4&gt;Conclusion&lt;/h4&gt;This study found that approximately half of patients with T2DM in Ethiopian studies were affected by overweight and obesity; there was a considerable difference across regions, with a higher prevalence observed in Addis Ababa.", "char_spans": [365, 571], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.7946, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.8136945962905884, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.814"}, {"extractor": "FineTuned-DistilBERT", "confidence": 0.7754475474357605, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.775"}]}]</data>
