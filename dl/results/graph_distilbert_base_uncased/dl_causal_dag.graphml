g exposure, insulin therapy, or coronary/ischemic heart disease.", "char_spans": [142, 163], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.8798573017120361, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.8798573017120361, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.880"}]}]</data>
