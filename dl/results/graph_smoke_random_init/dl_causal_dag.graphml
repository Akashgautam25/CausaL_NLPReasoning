      <data key="d9">[{"evidence_key": "PMID:42713502:s01", "pair_id": "PMID:42713502:s01:p01", "doc_id": "PMID:42713502", "sent_id": "PMID:42713502:s01", "pmid": "42713502", "url": "https://europepmc.org/article/MED/42713502", "sentence_text": "Insulin resistance (IR) and Type 2 diabetes mellitus (DM) are intricately related metabolic conditions that significantly contribute to the global health burden.", "char_spans": [0, 52], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.43334001302719116, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.43334001302719116, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.433"}]}, {"evidence_key": "PMID:42889580:s01", "pair_id": "PMID:42889580:s01:p02", "doc_id": "PMID:42889580", "sent_id": "PMID:42889580:s01", "pmid": "42889580", "url": "https://europepmc.org/article/MED/42889580", "sentence_text": "Insulin resistance is an early feature of type 2 diabetes mellitus (T2DM), but progression to persistent hyperglycemia requires failure of pancreatic \u03b2-cell compensation.", "char_spans": [0, 72], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.45395627617836, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.45395627617836, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.454"}]}, {"evidence_key": "PMID:42795278:s01", "pair_id": "PMID:42795278:s01:p02", "doc_id": "PMID:42795278", "sent_id": "PMID:42795278:s01", "pmid": "42795278", "url": "https://europepmc.org/article/MED/42795278", "sentence_text": "&lt;h4&gt;Background&lt;/h4&gt;Type 2 diabetes mellitus (T2DM) is a chronic metabolic disorder characterized by impaired glucose homeostasis, insulin resistance, and progressive \u03b2-cell dysfunction.", "char_spans": [19, 148], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.46643495559692383, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.46643495559692383, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.466"}]}, {"evidence_key": "PMID:42831040:s03", "pair_id": "PMID:42831040:s03:p01", "doc_id": "PMID:42831040", "sent_id": "PMID:42831040:s03", "pmid": "42831040", "url": "https://europepmc.org/article/MED/42831040", "sentence_text": "In type 2 diabetes mellitus, several pathological mechanisms, including prolonged hyperglycemia, oxidative damage, chronic inflammation, and impaired insulin sensitivity, are known to drive neurodegenerative processes and deterioration of cognitive function.", "char_spans": [3, 169], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.41645023226737976, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.41645023226737976, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.416"}]}, {"evidence_key": "PMID:42639604:s05", "pair_id": "PMID:42639604:s05:p03", "doc_id": "PMID:42639604", "sent_id": "PMID:42639604:s05", "pmid": "42639604", "url": "https://europepmc.org/article/MED/42639604", "sentence_text": "Insulin resistance was assessed using the Homeostatic Model Assessment of Insulin Resistance (HOMA-IR), and ultrasonography was used to evaluate hepatic steatosis.&lt;h4&gt;Results&lt;/h4&gt;Lean T2DM patients had significantly higher levels of glycated hemoglobin (HbA1c), homeostatic model assessment of insulin resistance (HOMA-IR), fasting glucose, fasting insulin, low-density lipoprotein (LDL) cholesterol, aspartate aminotransferase (AST), and total cholesterol, while high-density lipoprotein (HDL) cholesterol was lower than non-diabetic controls (all p &lt;0.001).", "char_spans": [0, 188], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.4391, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.444816529750824, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.445"}, {"extractor": "FineTuned-DistilBERT", "confidence": 0.43336954712867737, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.433"}]}, {"evidence_key": "PMID:42798059:s10", "pair_id": "PMID:42798059:s10:p01", "doc_id": "PMID:42798059", "sent_id": "PMID:42798059:s10", "pmid": "42798059", "url": "https://europepmc.org/article/MED/42798059", "sentence_text": "Within the T2DM group, FAM19A5 was lower in patients with metabolic syndrome (P = .004), insulin resistance (HOMA-IR &gt; 2.71; P = .023), or BMI \u226525 kg/m\u00b2 (P = .021).", "char_spans": [11, 107], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.442, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.43113774061203003, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.431"}, {"extractor": "FineTuned-DistilBERT", "confidence": 0.4529452621936798, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.453"}]}, {"evidence_key": "PMID:42502734:s01", "pair_id": "PMID:42502734:s01:p03", "doc_id": "PMID:42502734", "sent_id": "PMID:42502734:s01", "pmid": "42502734", "url": "https://europepmc.org/article/MED/42502734", "sentence_text": "&lt;h4&gt;Background&lt;/h4&gt;Type 2 diabetes mellitus (T2DM) progresses through prediabetes (PD), which is characterized by insulin resistance and \u03b2-cell dysfunction.", "char_spans": [19, 132], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.4793, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.4623965620994568, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.462"}, {"extractor": "FineTuned-DistilBERT", "confidence": 0.4961340129375458, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.496"}]}]</data>
