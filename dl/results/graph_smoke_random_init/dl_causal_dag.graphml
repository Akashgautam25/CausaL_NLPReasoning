      <data key="d9">[{"evidence_key": "PMID:42796348:s02", "pair_id": "PMID:42796348:s02:p03", "doc_id": "PMID:42796348", "sent_id": "PMID:42796348:s02", "pmid": "42796348", "url": "https://europepmc.org/article/MED/42796348", "sentence_text": "It is currently defined by the coexistence of hypertension, central obesity, dyslipidemia, and impaired glucose metabolism, with insulin resistance, chronic inflammation, and oxidative stress representing important underlying pathophysiological mechanisms.", "char_spans": [68, 147], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.4658001959323883, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.4658001959323883, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.466"}]}, {"evidence_key": "PMID:42694803:s05", "pair_id": "PMID:42694803:s05:p01", "doc_id": "PMID:42694803", "sent_id": "PMID:42694803:s05", "pmid": "42694803", "url": "https://europepmc.org/article/MED/42694803", "sentence_text": "There are interconnected perpetuating cycles involving hypothalamic-pituitary-adrenal (HPA) axis dysfunction, inflammation, obesity, insulin resistance, and MDD.", "char_spans": [124, 151], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.514802873134613, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.514802873134613, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.515"}]}]</data>
