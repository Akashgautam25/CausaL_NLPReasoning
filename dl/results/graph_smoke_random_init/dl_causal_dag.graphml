      <data key="d9">[{"evidence_key": "PMID:42799180:s09", "pair_id": "PMID:42799180:s09:p02", "doc_id": "PMID:42799180", "sent_id": "PMID:42799180:s09", "pmid": "42799180", "url": "https://europepmc.org/article/MED/42799180", "sentence_text": "Overweight BMI, elevated blood pressure, and alcohol consumption were also significantly associated with T2DM.&lt;h4&gt;Conclusion&lt;/h4&gt;The TGF-\u03b21 codon 10\u2009TC genotype and C allele were associated with T2DM in this study, whereas the CC genotype was not significantly associated.", "char_spans": [0, 199], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.42650413513183594, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.42650413513183594, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.427"}]}, {"evidence_key": "PMID:42571999:s02", "pair_id": "PMID:42571999:s02:p08", "doc_id": "PMID:42571999", "sent_id": "PMID:42571999:s02", "pmid": "42571999", "url": "https://europepmc.org/article/MED/42571999", "sentence_text": "We aimed to disentangle the specific neurotoxic impacts of adiposity from chronic hyperglycemia on cortical structure and function.&lt;h4&gt;Materials and methods&lt;/h4&gt;In this cross-sectional study, 102 matched participants (obese T2DM [n\u2009=\u200931], normal-weight T2DM [n\u2009=\u200940] and healthy controls [n\u2009=\u200931]) underwent high-resolution multimodal MRI, specifically Surface-Based Morphometry (SBM) and 2D-Regional Homogeneity (ReHo), to evaluate cortical thickness, area, and network synchronization.&lt;h4&gt;Results&lt;/h4&gt;Our analyses revealed that the obese T2DM cohort exhibited profound structural and functional vulnerability compared to normal-weight peers.", "char_spans": [253, 539], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.40188801288604736, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.40188801288604736, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.402"}]}, {"evidence_key": "PMID:41634666:s03", "pair_id": "PMID:41634666:s03:p01", "doc_id": "PMID:41634666", "sent_id": "PMID:41634666:s03", "pmid": "41634666", "url": "https://europepmc.org/article/MED/41634666", "sentence_text": "We sought to investigate the 2-year risk of reoperation following THA due to osteoarthritis (OA) among people with and without the metabolic risk factors, T2DM and obesity.", "char_spans": [155, 171], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.5251753330230713, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.5251753330230713, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.525"}]}, {"evidence_key": "PMID:42620560:s02", "pair_id": "PMID:42620560:s02:p04", "doc_id": "PMID:42620560", "sent_id": "PMID:42620560:s02", "pmid": "42620560", "url": "https://europepmc.org/article/MED/42620560", "sentence_text": "Men with obesity or type 2 diabetes (T2DM) and testosterone deficiency may lose skeletal muscle mass (SMM) during weight reduction.", "char_spans": [9, 35], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.40544694662094116, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.40544694662094116, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.405"}]}, {"evidence_key": "PMID:42317617:s01", "pair_id": "PMID:42317617:s01:p01", "doc_id": "PMID:42317617", "sent_id": "PMID:42317617:s01", "pmid": "42317617", "url": "https://europepmc.org/article/MED/42317617", "sentence_text": "Tirzepatide is a first-in-class, once-weekly dual GIP and GLP-1 receptor agonist approved for type 2 diabetes and obesity.", "char_spans": [94, 121], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.524052083492279, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.524052083492279, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.524"}]}, {"evidence_key": "PMID:42899427:s09", "pair_id": "PMID:42899427:s09:p01", "doc_id": "PMID:42899427", "sent_id": "PMID:42899427:s09", "pmid": "42899427", "url": "https://europepmc.org/article/MED/42899427", "sentence_text": "NAFLD fibrosis score had the highest AUROC (0.724) for advanced fibrosis in the entire cohort, while FIB-4 performed best in nonelder subjects.&lt;h4&gt;Conclusions&lt;/h4&gt;Older age, alcohol, T2DM, chronic HBV infection, and obesity were associated with advanced fibrosis.", "char_spans": [183, 223], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.4995565116405487, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.4995565116405487, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.500"}]}, {"evidence_key": "PMID:42450077:s04", "pair_id": "PMID:42450077:s04:p03", "doc_id": "PMID:42450077", "sent_id": "PMID:42450077:s04", "pmid": "42450077", "url": "https://europepmc.org/article/MED/42450077", "sentence_text": "Due to its metabolic effects, GLP-1 forms the basis of medications currently used to treat type 2 diabetes (T2DM) and obesity.", "char_spans": [108, 125], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.440128356218338, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.440128356218338, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.440"}]}, {"evidence_key": "PMID:42074925:s02", "pair_id": "PMID:42074925:s02:p02", "doc_id": 