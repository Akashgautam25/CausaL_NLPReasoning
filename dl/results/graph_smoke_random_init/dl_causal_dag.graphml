      <data key="d9">[{"evidence_key": "PMID:42700058:s02", "pair_id": "PMID:42700058:s02:p04", "doc_id": "PMID:42700058", "sent_id": "PMID:42700058:s02", "pmid": "42700058", "url": "https://europepmc.org/article/MED/42700058", "sentence_text": "Within this context, physical inactivity and prolonged sedentary behavior emerge as prominent, modifiable risk factors contributing to type 2 diabetes mellitus (T2DM).", "char_spans": [55, 159], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.4201447367668152, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.4201447367668152, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.420"}]}, {"evidence_key": "PMID:42745276:s01", "pair_id": "PMID:42745276:s01:p02", "doc_id": "PMID:42745276", "sent_id": "PMID:42745276:s01", "pmid": "42745276", "url": "https://europepmc.org/article/MED/42745276", "sentence_text": "&lt;h4&gt;Background&lt;/h4&gt;Type 2 diabetes mellitus (T2DM) requires sustained self-management across diet, physical activity, body weight, glucose monitoring, and medication-taking behaviours.", "char_spans": [19, 116], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.42378127574920654, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.42378127574920654, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.424"}]}, {"evidence_key": "PMID:42859675:s02", "pair_id": "PMID:42859675:s02:p03", "doc_id": "PMID:42859675", "sent_id": "PMID:42859675:s02", "pmid": "42859675", "url": "https://europepmc.org/article/MED/42859675", "sentence_text": "Whether circulating myokines and adipokines are related to HGI, or whether relationships differ across exercise modalities, is unclear.&lt;h4&gt;Objective&lt;/h4&gt;To examine associations of circulating myokines (irisin, myostatin, myonectin, IL-6, IL-15) and adipokines (leptin, adiponectin) with HGI, and whether associations differ between physically active and sedentary individuals and across exercise modalities.&lt;h4&gt;Methods&lt;/h4&gt;Cross-sectional study of 185 adults with T2DM recruited at Thumbay Hospital, Ajman, United Arab Emirates, classified as physically active (n=98) or sedentary (n=87), with active individuals sub-grouped by predominant modality: aerobic (70), resistance (11), combined (17).", "char_spans": [464, 560], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.4772849678993225, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.4772849678993225, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.477"}]}, {"evidence_key": "PMID:42694689:s02", "pair_id": "PMID:42694689:s02:p03", "doc_id": "PMID:42694689", "sent_id": "PMID:42694689:s02", "pmid": "42694689", "url": "https://europepmc.org/article/MED/42694689", "sentence_text": "Exercise and physical activity are cornerstones of T2DM management, but current recommendations remain largely centered on standardized exercise doses and uniform physical activity targets, with limited consideration of individual variability and medication-related safety.", "char_spans": [51, 180], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.6160945892333984, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.6160945892333984, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.616"}]}, {"evidence_key": "PMID:42597803:s04", "pair_id": "PMID:42597803:s04:p01", "doc_id": "PMID:42597803", "sent_id": "PMID:42597803:s04", "pmid": "42597803", "url": "https://europepmc.org/article/MED/42597803", "sentence_text": "The search strategy was constructed using terms related to type 2 diabetes mellitus, digital wearable devices, exercise self-management, physical activity, and behavior change.", "char_spans": [59, 154], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.4907319247722626, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.4907319247722626, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.491"}]}]</data>
