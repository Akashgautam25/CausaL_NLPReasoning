      <data key="d9">[{"evidence_key": "PMID:42739101:s07", "pair_id": "PMID:42739101:s07:p01", "doc_id": "PMID:42739101", "sent_id": "PMID:42739101:s07", "pmid": "42739101", "url": "https://europepmc.org/article/MED/42739101", "sentence_text": "Compared with non-dehydration and good sleep quality, the combination of dehydration and poor sleep quality was associated with substantially higher odds of prevalent T2DM (adjusted &lt;i&gt;OR&lt;/i&gt; 9.92, &lt;i&gt;95% CI&lt;/i&gt; 7.14 to 14.00).", "char_spans": [89, 171], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.471316397190094, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.471316397190094, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.471"}]}, {"evidence_key": "PMID:42607927:s01", "pair_id": "PMID:42607927:s01:p01", "doc_id": "PMID:42607927", "sent_id": "PMID:42607927:s01", "pmid": "42607927", "url": "https://europepmc.org/article/MED/42607927", "sentence_text": "&lt;h4&gt;Objective&lt;/h4&gt;To estimate the global prevalence of objectively confirmed obstructive sleep apnea (OSA) and the questionnaire-defined high-risk proportion among adults with type 2 diabetes mellitus (T2DM) and to explore sources of heterogeneity.&lt;h4&gt;Methods&lt;/h4&gt;PubMed, Web of Science, Scopus, and Cochrane Library were searched up to July 2025.", "char_spans": [89, 200], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.47820815443992615, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.47820815443992615, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.478"}]}]</data>
