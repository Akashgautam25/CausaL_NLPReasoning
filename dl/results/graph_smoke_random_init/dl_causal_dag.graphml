      <data key="d8">0.4803</data>
      <data key="d9">[{"evidence_key": "PMID:42796297:s01", "pair_id": "PMID:42796297:s01:p02", "doc_id": "PMID:42796297", "sent_id": "PMID:42796297:s01", "pmid": "42796297", "url": "https://europepmc.org/article/MED/42796297", "sentence_text": "&lt;i&gt;Background and Objectives&lt;/i&gt;: Type 2 diabetes mellitus (T2DM), visceral adiposity, and hypertension frequently coexist, but their independent associations with carotid intima-media thickness (cIMT) remain uncertain.", "char_spans": [34, 103], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.5094, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.453350692987442, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.453"}, {"extractor": "FineTuned-DistilBERT", "confidence": 0.565524160861969, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.566"}]}, {"evidence_key": "PMID:42796297:s06", "pair_id": "PMID:42796297:s06:p01", "doc_id": "PMID:42796297", "sent_id": "PMID:42796297:s06", "pmid": "42796297", "url": "https://europepmc.org/article/MED/42796297", "sentence_text": "&lt;i&gt;Results&lt;/i&gt;: T2DM was present in 39 patients (26.5%), hypertension in 125 (85.0%), and obesity in 120 (81.6%).", "char_spans": [16, 69], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.517676591873169, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.517676591873169, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.518"}]}, {"evidence_key": "PMID:42796297:s12", "pair_id": "PMID:42796297:s12:p01", "doc_id": "PMID:42796297", "sent_id": "PMID:42796297:s12", "pmid": "42796297", "url": "https://europepmc.org/article/MED/42796297", "sentence_text": "&lt;i&gt;Conclusions&lt;/i&gt;: T2DM identified metabolic dysregulation, whereas age and hypertension showed the strongest adjusted associations with cIMT.", "char_spans": [20, 89], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.5150490999221802, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.5150490999221802, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.515"}]}, {"evidence_key": "PMID:42303654:s03", "pair_id": "PMID:42303654:s03:p01", "doc_id": "PMID:42303654", "sent_id": "PMID:42303654:s03", "pmid": "42303654", "url": "https://europepmc.org/article/MED/42303654", "sentence_text": "This cross-sectional study utilized data from the \"Assessment in Quality of Care among Patients Receiving a Diagnosis of Type 2 Diabetes and Hypertension Visiting the Ministry of Public Health and Bangkok Metropolitan Administration Hospital\" database in Thailand.", "char_spans": [121, 153], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.40606382489204407, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.40606382489204407, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.406"}]}, {"evidence_key": "PMID:42575672:s08", "pair_id": "PMID:42575672:s08:p04", "doc_id": "PMID:42575672", "sent_id": "PMID:42575672:s08", "pmid": "42575672", "url": "https://europepmc.org/article/MED/42575672", "sentence_text": "Greater DASH adherence was associated with reduced risk of hypertension (aHR 0.91, 95% CI 0.86 to 0.96, p&lt;0.001) and T2DM (aHR 0.82, 95% CI 0.75 to 0.90, p&lt;0.001).&lt;h4&gt;Conclusions&lt;/h4&gt;Greater adherence to the DASH diet was associated with lower combined risk of HF and death due to HF, as well as hypertension and T2DM, supporting the role of a DASH diet in HF prevention.", "char_spans": [117, 308], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.4385297894477844, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.4385297894477844, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.439"}]}, {"evidence_key": "PMID:42461841:s14", "pair_id": "PMID:42461841:s14:p01", "doc_id": "PMID:42461841", "sent_id": "PMID:42461841:s14", "pmid": "42461841", "url": "https://europepmc.org/article/MED/42461841", "sentence_text": "Poor glycemic control was significantly associated with anemia, while elevated systolic blood pressure was associated with leukocytosis among type 2 diabetes mellitus patients.", "char_spans": [70, 166], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.47667983174324036, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.47667983174324036, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.477"}]}, {"evidence_key": "PMID:42588238:s02", "pair_id": "PMID:42588238:s02:p02", "doc_id": "PMID:42588238", "sent_id": "PMID:42588238:s02", "pmid": "42588238", "url": "https://europepmc.org/article/MED/42588238", "sentence_text": "Type 2 diabetes mellitus (T2DM), hypertension (HTN), and osteoarthritis (OA) are common in later life and may influence fall vulnerability through sensory, vascular, musculoskeletal, cognitive, medication-related, and functional pathways.", "char_spans": [0, 45], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.44188839197158813, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.44188839197158813, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.442"}]}, {"evidence_key": "PMID:42877484:s09", "pair_id": "PMID:42877484:s09:p01", "doc_id": "PMID:42877484", "sent_id": "PMID:42877484:s09", "pmid": "42877484", "url": "https://europepmc.org/article/MED/42877484", "sentence_text": "Of the cohort, 32%, 36%, and 74% had CVD, type 2 diabetes mellitus, and hypertension, respectively.", "char_spans": [42, 84], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.5624437928199768, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.5624437928199768, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.562"}]}, {"evidence_key": "PMID:42523603:s11", "pair_id": "PMID:42523603:s11:p01", "doc_id": "PMID:42523603", "sent_id": "PMID:42523603:s11", "pmid": "42523603", "url": "https://europepmc.org/article/MED/42523603", "sentence_text": "The presence of three metabolic comorbidities (T2DM, hypertension, and low HDL levels) was associated with poor OS, suggesting that metabolic burden may negatively affect survival once a certain number of factors accumulate.", "char_spans": [47, 65], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.45503729581832886, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.45503729581832886, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.455"}]}]</data>
