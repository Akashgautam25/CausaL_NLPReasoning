      <data key="d9">[{"evidence_key": "PMID:42571021:s08", "pair_id": "PMID:42571021:s08:p01", "doc_id": "PMID:42571021", "sent_id": "PMID:42571021:s08", "pmid": "42571021", "url": "https://europepmc.org/article/MED/42571021", "sentence_text": "Hypertension, HIV infection, obesity, and poor glycemic control were significant associated factors.", "char_spans": [0, 36], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.47173044085502625, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.47173044085502625, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.472"}]}, {"evidence_key": "PMID:42488722:s03", "pair_id": "PMID:42488722:s03:p01", "doc_id": "PMID:42488722", "sent_id": "PMID:42488722:s03", "pmid": "42488722", "url": "https://europepmc.org/article/MED/42488722", "sentence_text": "Metabolic syndrome (MetS)-defined by central obesity, hypertriglyceridemia, low HDL cholesterol, hypertension, and type 2 diabetes mellitus (T2DM)-is increasingly prevalent worldwide and is characterized by chronic immune dysregulation and alterations in gut microbiota.", "char_spans": [45, 109], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.5288763642311096, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.5288763642311096, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E2_E1 p=0.529"}]}]</data>
