th the highest TPC (2.84 and 1.90 respectively).", "char_spans": [0, 16], "extractor": "FineTuned-DistilBERT", "supporting_extractors": ["FineTuned-DistilBERT"], "confidence": 0.4060457646846771, "predictions": [{"extractor": "FineTuned-DistilBERT", "confidence": 0.4060457646846771, "polarity": "mixed_or_unclear", "language_status": "affirmed", "reasoning": "DistilBERT argmax=CAUSE_E1_E2 p=0.406"}]}]</data>
